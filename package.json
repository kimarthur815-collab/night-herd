{
  "name": "night-herd",
  "version": "0.1.0",
  "description": "Night Herd: 서부 개척시대 1인칭 공포 게임 (웹, Three.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "bake:cows": "node gen-slice.mjs 0.012 night/cows",
    "bake:hand": "node gen-hand.mjs 0.0016",
    "build": "npm run build:night",
    "build:night": "esbuild game-src.js --bundle --minify --format=iife --target=es2020 --define:WITH_COUNTING=false --define:WALK=false --define:NIGHT_SCENE=true --outfile=night/night.js",
    "serve": "python3 -m http.server 8000",
    "bake:plants": "node --max-old-space-size=6000 gen-plants.mjs 0.012 plants/data && npm run copy:plants",
    "copy:plants": "mkdir -p night/plants && cp plants/data/*.json night/plants/",
    "sculptview": "esbuild sculptview-src.js --bundle --format=esm --target=es2022 --outfile=sculptview.js",
    "bake:gunhand": "node gen-gunhand.mjs 0.0016",
    "bake:revolvers": "node --max-old-space-size=6000 gen-revolvers.mjs && npm run copy:revolver",
    "build:revolvers": "esbuild revolvers-src.js --bundle --minify --format=iife --target=es2020 --outfile=revolvers/revolvers.js",
    "copy:revolver": "mkdir -p night/revolver && cp revolvers/data/colt75.json night/revolver/",
    "bake:monsters": "node gen-monsters.mjs 0.0065",
    "build:monsters": "esbuild monsters-src.js --bundle --minify --format=iife --target=es2020 --outfile=monsters/monsters.js",
    "bake:cows-lite": "node gen-cows-lite.mjs 0.0009 && node gen-cows-lite.mjs 0.003 monsters/cows-far",
    "release": "node bump-version.mjs && npm run build",
    "stamp": "node bump-version.mjs --stamp"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "meshoptimizer": "^1.3.0"
  }
}
